type hal_usb_xring, domain;
type hal_usb_xring_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_usb_xring)

hal_server_domain(hal_usb_xring, hal_usb)
hal_attribute_service(hal_usb, hal_usb_service)

set_prop(hal_usb_xring, vendor_mtk_usb_prop)
set_prop(hal_usb_xring, vendor_usb_prop)
get_prop(hal_usb_xring, usb_control_prop)

allow hal_usb_xring configfs:dir create_dir_perms;
allow hal_usb_xring configfs:file rw_file_perms;
allow hal_usb_xring kmsg_device:chr_file { open write };
allow hal_usb_xring self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
allow hal_usb_xring vendor_sysfs_usb_c:dir r_dir_perms;
allow hal_usb_xring vendor_sysfs_usb_c:file rw_file_perms;
allow hal_usb_xring vendor_sysfs_usb_device:dir r_dir_perms;
allow hal_usb_xring vendor_sysfs_usb_device:file rw_file_perms;
