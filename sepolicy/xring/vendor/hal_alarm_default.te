type hal_alarm_default, domain;
type hal_alarm_default_exec, exec_type, vendor_file_type, file_type;
type hal_alarm_default_service, hal_service_type, service_manager_type;

init_daemon_domain(hal_alarm_default)

allow hal_alarm_default hal_alarm_default_service:service_manager { add find };

binder_use(hal_alarm_default)

allow hal_alarm_default rtc_device:chr_file rw_file_perms;
