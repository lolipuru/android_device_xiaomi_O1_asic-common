type hal_usb_gadget_xring, domain;
type hal_usb_gadget_xring_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_usb_gadget_xring)

hal_server_domain(hal_usb_gadget_xring, hal_usb_gadget)
hal_attribute_service(hal_usb_gadget, hal_usb_gadget_service)

get_prop(hal_usb_gadget_xring, usb_control_prop)
get_prop(hal_usb_gadget_xring, vendor_mtk_meta_atm_type_prop)
get_prop(hal_usb_gadget_xring, vendor_usb_prop)

allow hal_usb_gadget_xring configfs:dir create_dir_perms;
allow hal_usb_gadget_xring configfs:file create_file_perms;
allow hal_usb_gadget_xring configfs:lnk_file { create unlink };
allow hal_usb_gadget_xring functionfs:dir r_dir_perms;
allow hal_usb_gadget_xring functionfs:file r_file_perms;
allow hal_usb_gadget_xring kmsg_device:chr_file { open write };
allow hal_usb_gadget_xring vendor_sysfs_usb_device:dir r_dir_perms;
allow hal_usb_gadget_xring vendor_sysfs_usb_device:file r_file_perms;
