type hal_c2_x, domain;
type hal_c2_x_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_c2_x)

hal_server_domain(hal_c2_x, hal_codec2)
hal_server_domain(hal_c2_x, hal_x_jpeg)

binder_use(hal_c2_x)
binder_call(hal_c2_x, hal_gcb_impl)
binder_call(hal_c2_x, hal_perfflinger_default)
binder_call(hal_c2_x, xplayer_client)

set_prop(hal_c2_x, vendor_vpu_prop)
get_prop(hal_c2_x, graphics_config_prop)
get_prop(hal_c2_x, graphics_config_writable_prop)
get_prop(hal_c2_x, vendor_npu_prop)
get_prop(hal_c2_x, vendor_xring_c2x_debug_prop)
get_prop(hal_c2_x, vendor_xring_c2x_info_prop)
get_prop(hal_c2_x, vendor_xring_gralloc_prop)

allow hal_c2_x dmabuf_heap_device:chr_file r_file_perms;
allow hal_c2_x dmabuf_system_heap_device:chr_file rw_file_perms;
allow hal_c2_x dumpstate:fifo_file { append write };
allow hal_c2_x fwk_sensor_service:service_manager find;
allow hal_c2_x gpu_device:chr_file rw_file_perms;
allow hal_c2_x hal_graphics_allocator_default_tmpfs:file rw_file_perms;
allow hal_c2_x hal_perfflinger_default_service:service_manager find;
allow hal_c2_x logd:unix_stream_socket connectto;
allow hal_c2_x logdr_socket:sock_file write;
allow hal_c2_x mitee_client_device:chr_file rw_file_perms;
allow hal_c2_x self:netlink_kobject_uevent_socket { bind create read };
allow hal_c2_x su:fifo_file append;
allow hal_c2_x sysfs_large_page_conf:file r_file_perms;
allow hal_c2_x sysfs_thermal:dir search;
allow hal_c2_x sysfs_thermal:file r_file_perms;
allow hal_c2_x sysfs:file r_file_perms;
allow hal_c2_x system_server:fifo_file { append write };
allow hal_c2_x tombstone_data_file:file append;
allow hal_c2_x tombstoned_crash_socket:sock_file write;
allow hal_c2_x tombstoned:fd use;
allow hal_c2_x tombstoned:unix_stream_socket connectto;
allow hal_c2_x unlabeled:filesystem getattr;
allow hal_c2_x vendor_data_file:dir create_dir_perms;
allow hal_c2_x vendor_data_file:file create_file_perms;
allow hal_c2_x vendor_gamingplus_data_file:dir search;
allow hal_c2_x vendor_gamingplus_data_file:file r_file_perms;
allow hal_c2_x vendor_hal_gcb_service:service_manager find;
allow hal_c2_x vendor_sysfs_graphics:dir search;
allow hal_c2_x vendor_sysfs_graphics:file r_file_perms;
allow hal_c2_x video_device:chr_file rw_file_perms;
allow hal_c2_x vndbinder_device:chr_file rw_file_perms;
allow hal_c2_x xplayer_client:fd use;
allow hal_c2_x xplayer_client:file open;
allow hal_c2_x xr_dmabuf_helper:chr_file rw_file_perms;
