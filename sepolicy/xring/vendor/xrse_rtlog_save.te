type xrse_rtlog_save, domain;
type xrse_rtlog_save_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(xrse_rtlog_save)

allow xrse_rtlog_save xrse_rtlog_device:chr_file rw_file_perms;
allow xrse_rtlog_save xrlog_data_file:dir create_dir_perms;
allow xrse_rtlog_save xrlog_data_file:file create_file_perms;