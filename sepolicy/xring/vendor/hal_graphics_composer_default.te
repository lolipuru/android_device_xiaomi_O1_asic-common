type hal_graphics_composer_ext_service, hal_service_type, service_manager_type;
type hal_graphics_composer_tuning_service, hal_service_type, service_manager_type;

hal_server_domain(hal_graphics_composer_default, hal_graphics_composer_ext)
hal_server_domain(hal_graphics_composer_default, hal_graphics_composer_tuning)
hal_attribute_service(hal_graphics_composer_ext, hal_graphics_composer_ext_service)
hal_attribute_service(hal_graphics_composer_tuning, hal_graphics_composer_tuning_service)

allow hal_graphics_composer_default hal_graphics_composer_ext_service:service_manager { add find };
allow hal_graphics_composer_default hal_graphics_composer_tuning_service:service_manager { add find };
allow hal_graphics_composer_default hal_graphics_mapper_service:service_manager find;
allow hal_graphics_composer_default hal_perfflinger_default_service:service_manager find;

binder_call(hal_graphics_composer_default, hal_perfflinger_default)
