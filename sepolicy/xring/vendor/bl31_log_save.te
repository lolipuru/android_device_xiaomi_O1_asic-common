type bl31_log_save, domain;
type bl31_log_save_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(bl31_log_save)

allow bl31_log_save bl31_log_device:chr_file rw_file_perms;
allow bl31_log_save xrlog_data_file:dir create_dir_perms;
allow bl31_log_save xrlog_data_file:file create_file_perms;
