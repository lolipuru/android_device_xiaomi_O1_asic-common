type hal_gamingplus_impl, domain;
type hal_gamingplus_impl_exec, exec_type, vendor_file_type, file_type;
type hal_gamingplus_service, hal_service_type, service_manager_type;

init_daemon_domain(hal_gamingplus_impl)

hal_server_domain(hal_gamingplus_impl, hal_gamingplus)
hal_attribute_service(hal_gamingplus, hal_gamingplus_service)

binder_use(hal_gamingplus_impl)
binder_call(hal_gamingplus_impl, hal_perfflinger_default)
binder_call(hal_gamingplus_impl, hal_schedgenius_default)

allow hal_gamingplus_impl hal_perfflinger_default_service:service_manager find;
allow hal_gamingplus_impl hal_schedgenius_hwservice:service_manager find;
allow hal_gamingplus_impl vendor_gamingplus_data_file:dir create_dir_perms;
allow hal_gamingplus_impl vendor_gamingplus_data_file:file create_file_perms;

