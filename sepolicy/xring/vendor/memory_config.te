type memory_config, domain;
type memory_config_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(memory_config)

set_prop(memory_config, vendor_memory_prop)

allow memory_config self:capability sys_admin;
allow memory_config block_device:dir r_dir_perms;
allow memory_config { ram_device swap_block_device }:blk_file rw_file_perms;
allow memory_config proc:file rw_file_perms;
allow memory_config proc_meminfo:file r_file_perms;
allow memory_config sysfs_zram:dir r_dir_perms;
allow memory_config sysfs_zram:file rw_file_perms;
allow memory_config sysfs_transparent_hugepage:file rw_file_perms;
allow memory_config sysfs_xr_hugepage:dir search;
allow memory_config sysfs_xr_hugepage:file rw_file_perms;
allow memory_config sysfs_memory_event:dir search;
allow memory_config sysfs_memory_event:file rw_file_perms;
allow memory_config rootfs:file rx_file_perms;
allow memory_config vendor_shell_exec:file rx_file_perms;
allow memory_config vendor_toolbox_exec:file rx_file_perms;
