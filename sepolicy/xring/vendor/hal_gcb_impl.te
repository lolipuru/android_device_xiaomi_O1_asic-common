type hal_gcb_impl, domain;
type hal_gcb_impl_exec, exec_type, vendor_file_type, file_type;
type vendor_hal_gcb_service, hal_service_type, service_manager_type;

init_daemon_domain(hal_gcb_impl)

hal_client_domain(hal_gcb_impl, hal_graphics_allocator)

binder_use(hal_gcb_impl)
binder_call(hal_gcb_impl, hal_camera_default)

get_prop(hal_gcb_impl, hwservicemanager_prop)

allow hal_gcb_impl vendor_hal_gcb_service:service_manager { add find };
allow hal_gcb_impl hal_graphics_allocator_service:service_manager find;
allow hal_gcb_impl hal_graphics_mapper_hwservice:hwservice_manager find;
allow hal_gcb_impl vndbinder_device:chr_file rw_file_perms;
allow hal_gcb_impl graphics_device:chr_file rw_file_perms;
allow hal_gcb_impl dmabuf_system_heap_device:chr_file r_file_perms;
allow hal_gcb_impl hal_graphics_allocator_default:fd use;
allow hal_gcb_impl hal_graphics_allocator_default_tmpfs:file rw_file_perms;
allow hal_gcb_impl hal_c2_x:binder transfer;
allow hal_gcb_impl vendor_data_file:dir create_dir_perms;
allow hal_gcb_impl vendor_data_file:file create_file_perms;
