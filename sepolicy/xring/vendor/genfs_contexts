# Graphics
genfscon sysfs "/module/mali_kbase/parameters/large_page_conf" u:object_r:sysfs_large_page_conf:s0

# Kernel
genfscon sysfs "/module/xring_lmk"                             u:object_r:sysfs_xringlmk:s0
genfscon sysfs "/kernel/xr_hugepage"                           u:object_r:sysfs_xr_hugepage:s0

# UFS
genfscon sysfs "/class/udc/e1ac0000.dwc3"                      u:object_r:vendor_sysfs_usb_device:s0

# USB
genfscon sysfs "/devices/platform/soc/e1ac0000.xr_usb"         u:object_r:vendor_sysfs_usb_device:s0
genfscon sysfs "/devices/platform/soc/soc:xr_usb_adsp/supp_adsp" u:object_r:vendor_sysfs_usb_device:s0

# Logging
genfscon proc "/xgpu/gpu_memory"                               u:object_r:proc_gpu_memory:s0
genfscon proc "/tmi_log0"                                      u:object_r:proc_tmi_log:s0
genfscon proc "/tmi_log1"                                      u:object_r:proc_tmi_log:s0
genfscon proc "/fastbootlog"                                   u:object_r:proc_fastbootlog:s0
