# Audio
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
audio.deep_buffer.media=true
audio.offload.disable=true
persist.audio.thread.ozonotify=false
persist.vendor.audio.auto.scenario=true
persist.vendor.audio.misound.disable=true
persist.vendor.audio.spatializer.enable=false
persist.vendor.batteryantiaging=1
ro.audio.spatializer_enabled=true
ro.audio.stereo_spatialization_enabled=true
ro.miui.audio.karaoke.suppot.lowlatency=true
ro.vendor.audio.dualadc.support=true
ro.vendor.audio.feature.fade=true
ro.vendor.audio.feature.spatial=5
ro.vendor.audio.gain.support=true
ro.vendor.audio.game.mode=true
ro.vendor.audio.karaoke.enable=true
ro.vendor.audio.misound.bluetooth.enable=true
ro.vendor.audio.misound.systemsound=true
ro.vendor.audio.multi.channel=true
ro.vendor.audio.multichannel.5point1.headset=true
ro.vendor.audio.multichannel.5point1=false
ro.vendor.audio.multiroute=true
ro.vendor.audio.remotesubmix.support_multichannel=true
ro.vendor.audio.sfx.earadj=true
ro.vendor.audio.sfx.scenario=true
ro.vendor.audio.sos=true
ro.vendor.audio.soundfx.type=mi
ro.vendor.audio.soundfx.usb=true
ro.vendor.audio.soundtrigger.support_record_type=0x0022
ro.vendor.audio.spatializer.support.speaker=true
ro.vendor.audio.support.sound.id=true
ro.vendor.audio.surround.headphone.only=true
ro.vendor.audio.videobox.switch=true
ro.vendor.audio.voiceassist.support_record_type=0x0022
vendor.audio.spkcal.copy.inhal=true
vendor.audio.wps.resume=false
vendor.audio.version.v=true

# Bluetooth
ro.bluetooth.a2dp_offload.supported=true
ro.bluetooth.leaudio_offload.supported=true
persist.bluetooth.leaudio_offload.disabled=false
persist.bluetooth.a2dp_offload.disabled=false
ro.vendor.audio.BTCodec.unsupport.spatial=APTX;APTX_HD;APTX_ADAPTIVE;APTX_TWSP;LHDCV1;LHDCV2;LHDCV3;LHDCV5;LDAC;LC3
ro.bluetooth.finder.supported=true
ro.bluetooth.emb_wp_mode=false
ro.bluetooth.wipower=false
persist.vendor.service.bdroid.soc.alwayson=true

# Crypto
ro.vendor.wv.mi_oemcrypto.enable_pro40=true
ro.vendor.mitee_tui.support=1

# Display
debug.sf.enable_hwc_vds=1
debug.sf.predict_hwc_composition_strategy=0
graphics.gpu.profiler.support=true
persist.sys.sf.color_mode=0
ro.hardware.egl=mali
ro.hardware.vulkan=mali
ro.opengles.version=196610
ro.surface_flinger.enable_frame_rate_override=true
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.protected_contents=true
ro.surface_flinger.running_without_sync_framework=false
ro.surface_flinger.use_color_management=true
vendor.xring.gralloc.afbc_enable=1
vendor.xring.gralloc.afbc_scramble=1
ro.surface_flinger.set_touch_timer_ms=200
ro.vendor.display.update_dbi_by_temperature=true
ro.vendor.display.adaptive_hdr2.enable=1
vendor.display.enable_display_power_notify=1
vendor.display.enable_backlight_prop_send=0
vendor.display.force_tonemapping=1

