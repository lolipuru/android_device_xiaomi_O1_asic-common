# Media
debug.config.media.video.voip.detect=true
debug.stagefright.c2inputsurface=-1
debug.stagefright.ccodec_timeout_mult=10
debug.video.codec.capability.apilevel=2
debug.video.codec.capability.support=16383
debug.video.render.broadcast.support=true
media.c2.hal.selection=aidl
media.stagefright.thumbnail.prefer_hw_codecs=true

# Platform
ro.board.platform=O1_asic

# USB
vendor.usb.controller=e1ac0000.dwc3

# Volume
ro.config.media_vol_steps=15
ro.config.media_vol_default=10
ro.config.vc_call_vol_steps=11
ro.config.alarm_vol_steps=15
ro.config.system_vol_steps=15

# Wifi
